# Configuración de Base de Datos
DATABASE_URL=mysql+pymysql://envios_user:envios_pass@db:3306/envios_db

# Configuración de Seguridad
# Genera una con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Configuración de MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=envios_db
MYSQL_USER=envios_user
MYSQL_PASSWORD=envios_pass

# Orígenes permitidos para CORS (JSON)
CORS_ORIGINS=["http://localhost"]
